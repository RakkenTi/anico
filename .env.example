# Copy to .env beside docker-compose.yml and edit. ./setup.sh does this for you.

# Optional. The compose file already defaults to ghcr.io/rakkenti/anico:latest,
# which is a public package and pulls without a login, so leave this alone to
# track the latest build.
#
# Set it to pin a tag instead. With watchtower following :latest every minute,
# this is how you freeze on a known-good build or roll back after a bad one --
# watchtower will not move you off a pinned tag. Note GHCR names are lowercase
# even though the repo is RakkenTi/anico.
#
# ANICO_IMAGE=ghcr.io/rakkenti/anico:sha-1a2b3c4

# "false" only if the instance is served over plain HTTP with no TLS proxy,
# otherwise the browser drops the session cookie and login silently fails.
COOKIE_SECURE=true

# --- optional ---------------------------------------------------------------

# Gap between catalog crawl requests, in milliseconds. The catalog is filled in
# four sweeps (anime then manga, headline cast then supporting), 800 requests in
# all, so the default walks the lot in about three and a half hours at roughly
# four requests a minute, which leaves AniList's budget to player searches. The
# first sweep is most-popular-first, so the instance is worth playing long
# before it finishes. Lower this only if you are impatient and nobody else is
# using the instance.
# CRAWL_DELAY_MS=15000

# The crawl stops rather than grow the database past this many bytes. A full
# four-sweep catalog settles well under 100 MB, so the 1 GB default is headroom,
# not a limit you are expected to meet.
# MAX_DB_BYTES=1073741824

# Seconds between watchtower's checks for a new image. The default of 60 keeps
# the instance within a minute or two of whatever master last published. Raise
# it if you would rather updates not land mid-session.
# WATCHTOWER_POLL_INTERVAL=60
