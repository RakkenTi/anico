# Copy to .env beside docker-compose.yml and edit.

# The published image to run. Lowercase owner and repo, exactly as GHCR names it.
ANICO_IMAGE=ghcr.io/rakkenti/anico:latest

# "false" only if the instance is served over plain HTTP with no TLS proxy,
# otherwise the browser drops the session cookie and login silently fails.
COOKIE_SECURE=true
